# The part of pypdfium2 (which ships no types) that sift calls, to picture a scan's pages (see ocr.pages).
from PIL.Image import Image

class PdfBitmap:
    def to_pil(self) -> Image: ...

class PdfPage:
    def get_size(self) -> tuple[float, float]: ...
    def render(self, scale: float = 1) -> PdfBitmap: ...
    def close(self) -> None: ...

class PdfDocument:
    def __init__(self, input: bytes) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> PdfPage: ...
    def close(self) -> None: ...
